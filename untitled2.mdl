    subviewer		    2
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [tS, dest] = fcn()\n% Generador de Tiempos de Servicio (Camas) y Sorteo de Destinos\n% Basado en Distribución Empírica\n\n% 1. Definimos los límites superiores (x) y las probabilidades (y)\n% Estos datos salen de tu tabla \"Tiempos de servicio\"\n%limites = [14.54, 29.07, 43.61, 58.14, 72.68, 87.21, 101.75, 116.29, 130.82, 145.36, 159.89, 174.43, 188.96, 203.50, 218.04, 232.57, 247.11, 261.64, 276.18, 290.71];\n%prob_acumulada = [0.623, 0.817, 0.879, 0.918, 0.938, 0.958, 0.966, 0.969, 0.975, 0.977, 0.977, 0.980, 0.980, 0.980, 0.980, 0.983, 0.983, 0.983, 0.983, 1.000];\nlimites = [14.54, 29.07, 43.61, 58.14, 72.68, 87.21, 101.75, 116.29, 130.82];\nprob_acumulada = [0.648, 0.817, 0.879, 0.918, 0.938, 0.958, 0.966, 0.969, 1];\n\n% 2. Generamos un número aleatorio uniforme (0,1) para el tiempo\nu = rand;\n\n% 3. Interpolación para encontrar el tiempo de servicio 'tS'\nidx = 1;\nfor i = 1:length(prob_acumulada)\n    if u <= prob_acumulada(i)\n        idx = i;\n        break;\n    end\nend\n\nif idx == 1\n    limite_inf = 0;\n    prob_inf = 0;\nelse\n    limite_inf = limites(idx-1);\n    prob_inf = prob_acumulada(idx-1);\nend\n\nlimite_sup = limites(idx);\nprob_sup = prob_acumulada(idx);\n\n% Evitar división por cero en intervalos vacíos\nif prob_sup == prob_inf\n    tS = limite_inf;\nelse\n    % Interpolación lineal\n    tS = limite_inf + (limite_sup - limite_inf) * ((u - prob_inf) / (prob_sup - prob_inf));\nend\n\n% --- Sorteo de destinos (Este bloque se mantiene igual que el tuyo) ---\nr = rand;\nif r < 0.4091\n    dest = 3; % Egreso\nelseif r < 0.806\n    dest = 2; % Cama externa\nelse\n    dest = 1; % Quirófano\nend\n\nend"
      editorLayout	      "100 M4x1[146 214 671 364]"
    }
  }
