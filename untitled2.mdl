    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    9
    treeNode		    [9 0 0 0]
    superState		    SUBCHART
    subviewer		    9
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function dt = fcn(dummy) % <--- ¡CAMBIO AQUÍ! Añadimos 'dummy' como entrada\n% Generador de tiempos entre llegadas por Distribución Empírica\n\n% 1. Definimos los límites superiores (x) y las probabilidades (y)\nlimites = [1.49, 2.97, 4.46, 5.95, 7.43, 8.92, 10.41, 11.90, 13.38, 14.87, 16.36, 17.84, 19.33, 20.82, 22.30, 23.79, 25.28, 26.76, 28.25, 29.74];\nprob_acumulada = [0.324, 0.493, 0.620, 0.713, 0.789, 0.831, 0.879, 0.904, 0.913, 0.921, 0.938, 0.952, 0.955, 0.963, 0.975, 0.980, 0.983, 0.989, 0.992, 1.000];\n\n% 2. Generamos un número aleatorio uniforme (0,1) internamente\nu = rand; \n\n% 3. Interpolación para encontrar el tiempo 'dt'\nidx = 1;\nfor i = 1:length(prob_acumulada)\n    if u <= prob_acumulada(i)\n        idx = i;\n        break;\n    end\nend\n\n% 4. Calculamos el valor interpolado\nif idx == 1\n    limite_inf = 0;\n    prob_inf = 0;\nelse\n    limite_inf = limites(idx-1);\n    prob_inf = prob_acumulada(idx-1);\nend\n\nlimite_sup = limites(idx);\nprob_sup = prob_acumulada(idx);\n\n% Fórmula de interpolación lineal\ndt = limite_inf + (limite_sup - limite_inf) * ((u - prob_inf) / (prob_sup - prob_inf));\n\n% (Opcional) Evitar que dt sea exactamente cero (a veces trae problemas en SimEvents)\nif dt <= 0\n    dt = 0.001; \nend\n\nend"
      editorLayout	      "100 M4x1[146 214 1928 962]"
    }
  }
