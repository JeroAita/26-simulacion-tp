    eml {
      isEML		      1
      script		      "function tQ = fcn()\n% Generador de Tiempos de Servicio (Quirófano) - Distribución Empírica\n\n% REEMPLAZA LOS NÚMEROS POR TUS DATOS REALES:\nlimites = [1.5, 3.0, 4.5]; \nprob_acumulada = [0.3, 0.7, 1.0]; \n\nu = rand;\nidx = 1;\nfor i = 1:length(prob_acumulada)\n    if u <= prob_acumulada(i)\n        idx = i;\n        break;\n    end\nend\n\nif idx == 1\n    limite_inf = 0;\n    prob_inf = 0;\nelse\n    limite_inf = limites(idx-1);\n    prob_inf = prob_acumulada(idx-1);\nend\n\nlimite_sup = limites(idx);\nprob_sup = prob_acumulada(idx);\n\nif prob_sup == prob_inf\n    tQ = limite_inf;\nelse\n    tQ = limite_inf + (limite_sup - limite_inf) * ((u - prob_inf) / (prob_sup - prob_inf));\nend\nend"
      editorLayout	      "100 M4x1[291 220 671 364]"
    }
